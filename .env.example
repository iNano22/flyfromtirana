# Copy this file to .env for local runs. Never commit .env.
# On GitHub these come from Settings -> Secrets and variables -> Actions.

# Travelpayouts: Tools -> API (token) and your profile (marker = your partner ID)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_api_token
TRAVELPAYOUTS_MARKER=123456

# Telegram: token from @BotFather; channel as @username (public) or -100... id (private)
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHANNEL_ID=@flyfromtirana

# Only needed when premium.enabled is true in config.yaml.
# A private channel has no @name: use its numeric id, which starts with -100.
TELEGRAM_PREMIUM_CHANNEL_ID=
